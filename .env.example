# ION AT SCALE — PRODUCTION ENVIRONMENT CONFIGURATION

# Application & Environment
ION_ENV=production
ION_WAKE_PHRASE="Hey Ion"
VOICE_ENABLED=true
VAD_ENABLED=true
SILENCE_TIMEOUT=1.5
MIN_SPEECH_DURATION=0.3
MAX_TURN_DURATION=30.0
DEBUG=false
SECRET_KEY=change_this_to_a_secure_random_256bit_key

# Database & Cache Configuration
DATABASE_URL=postgresql://ion_user:secure_password@localhost:5432/ion_db
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_PATH=knowledge_vector_store.json

# API Keys & LLM Credentials
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
HF_API_KEY=your_huggingface_api_key_here
SEARCH_API_KEY=your_searxng_or_serp_key_here
EMBEDDING_API_KEY=your_embedding_api_key_here
STT_API_KEY=your_whisper_stt_key_here
TTS_API_KEY=your_tts_key_here
VISION_API_KEY=your_vision_key_here

# Security, CORS & Rate Limits
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=10
MAX_UPLOAD_SIZE_MB=10
MAX_CONCURRENT_JOBS_PER_USER=3
MAX_WS_CONNECTIONS_PER_USER=5

# RAG & Knowledge Base
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
